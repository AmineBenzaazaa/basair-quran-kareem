{
  "name": "tafsirapp",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dashboard:dev": "cd dashboard && npm run dev",
    "dashboard:build": "cd dashboard && npm run build",
    "dashboard:start": "cd dashboard && npm run start",
    "content:build": "node scripts/convert-docx.js",
    "supabase:content:push": "node scripts/push-content-to-supabase.mjs",
    "generate:content": "npx tsc --pretty false --module commonjs --target es2020 --esModuleInterop --skipLibCheck --outDir .tmp scripts/generate-content.ts && node .tmp/generate-content.js && rm -rf .tmp",
    "generate:content:watch": "node scripts/watch-generate-content.js",
    "generate:quran": "npx tsc --pretty false --module commonjs --target es2020 --esModuleInterop --skipLibCheck --outDir .tmp scripts/generate-quran-tafsir.ts && node .tmp/generate-quran-tafsir.js && rm -rf .tmp",
    "generate:data": "npx tsc --pretty false --module commonjs --target es2020 --esModuleInterop --skipLibCheck --outDir .tmp scripts/generate-data.ts && node .tmp/generate-data.js && rm -rf .tmp",
    "generate:data:watch": "node scripts/watch-generate-data.js",
    "generat": "node scripts/watch-generate-content.js"
  },
  "dependencies": {
    "@expo-google-fonts/amiri": "^0.2.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@supabase/supabase-js": "^2.103.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.19",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "mammoth": "^1.6.0",
    "typescript": "^5.3.0"
  },
  "private": true
}
